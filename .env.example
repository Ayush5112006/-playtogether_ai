# PlayTogether AI — Environment Variables
# Copy to .env.local for local development.

# Supabase Public Configuration (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Port
PORT=3000

# Virtual Fire TV Remote Testing Simulator
# Set to 'true' in development/QA to show the floating virtual remote
# Default is 'false' for production Fire TV deployment
NEXT_PUBLIC_ENABLE_VIRTUAL_REMOTE=true

# Optional AI Service Provider Key (for dynamic question generation)
# If omitted or unavailable, the authoritative Supabase seed question bank is seamlessly used
AI_SERVICE_API_KEY=your-ai-key-optional
